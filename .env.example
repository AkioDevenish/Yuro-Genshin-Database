# Copy this file to .env.local and fill it in.

# PostgreSQL connection string. REQUIRED.
# Free hosting: neon.tech or supabase.com — create a project and copy the string.
# On Vercel, the Postgres/Neon integration sets POSTGRES_URL for you and this can be left unset.
#
# Use the POOLED connection string on serverless (Neon "-pooler" host, Supabase port 6543).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Signs the session cookie. REQUIRED in production — the app refuses to start without it.
# Generate one with:  openssl rand -hex 32
AUTH_SECRET=

# Currency used for every valuation shown in the interface (ISO 4217 code).
# NEXT_PUBLIC_CURRENCY=USD

# Only read by `npm run seed` when creating the first administrator.
# ADMIN_NAME=IICA Administrator
# ADMIN_EMAIL=admin@iica.org
# ADMIN_PASSWORD=ChangeMe123
